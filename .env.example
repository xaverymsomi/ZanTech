# ---------------------------------------------------------------------
# ZanTech Environment Template
# ---------------------------------------------------------------------
# Copy this file to `.env` and replace placeholder values for your
# local, staging, or production environment.
#
# Never commit real secrets in `.env`.

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
APP_ENV=local
APP_DEBUG=1
SYSTEM_MODE=live
APP_KEY=change-me-to-a-long-random-secret
PASS_SALT=change-me-to-a-long-random-salt
HASH_ALGO=sha256

# Public URLs. Leave APP_DIR empty when the app runs at the domain root.
URL1=http://localhost:8000
PORTAL_URL=http://localhost:8000
API_URL=http://localhost:8000/api
ATTACHMENT_URL=http://localhost:8000
APP_DIR=

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
# Supported values depend on installed PDO drivers:
# sqlsrv, mysql, odbc, pgsql, sqlite
DB_TYPE=sqlsrv
DB_HOST=localhost
DB_PORT=1433
DB_NAME=zantech
DB_USER=zantech_user
DB_PASS=change-me

# Optional named connection example. Models may call setConnection('billing')
# or define protected string $connection = 'billing'.
# DB_BILLING_TYPE=sqlsrv
# DB_BILLING_HOST=localhost
# DB_BILLING_PORT=1433
# DB_BILLING_NAME=zantech_billing
# DB_BILLING_USER=billing_user
# DB_BILLING_PASS=change-me

# ---------------------------------------------------------------------
# Security And Runtime Toggles
# ---------------------------------------------------------------------
# These may also be stored in mx_setting and read through Config::get().
ZT_RATE_LIMIT=0
ZT_CSRF_ENABLED=0
ZT_SLOW_QUERY_THRESHOLD=100

# Optional comma-separated module allowlist. Leave empty to allow all modules.
ZT_ALLOWED_MODULES=

# ---------------------------------------------------------------------
# Mailgun
# ---------------------------------------------------------------------
MAILGUN_API_KEY=
MAILGUN_API_HOSTNAME=https://api.mailgun.net
MAILGUN_DOMAIN=

