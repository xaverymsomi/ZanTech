{
  "name": "oryn/framework",
  "description": "Oryn is a lightweight modular PHP framework with MVC modules, RBAC, CLI tooling, and SQL migrations.",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "phpmailer/phpmailer": "*",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-fileinfo": "*",
    "ext-curl": "*",
    "phpoffice/phpspreadsheet": "*",
    "mailgun/mailgun-php": "*",
    "kriswallsmith/buzz": "*",
    "nyholm/psr7": "*",
    "fpdf/fpdf": "^1.84",
    "vlucas/phpdotenv": "*",
    "ext-simplexml": "*",
    "dompdf/dompdf": "*",
    "endroid/qr-code": "*",
    "alphaolomi/mrz": "^1.0",
    "chillerlan/php-qrcode": "^5.0",
    "aferrandini/phpqrcode": "^1.0",
    "ext-gd": "*",
    "ext-openssl": "*",
    "mpdf/mpdf": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "Logging\\": "src/Logging/",
      "Config\\": "src/Config/",
      "View\\": "src/View/",
      "Validation\\": "src/Validation/",
      "Http\\": "src/Http/",
      "Exceptions\\": "src/Exceptions/",
      "Foundation\\": "src/Foundation/",
      "Authentication\\": "src/Authentication/",
      "Database\\": "src/Database/",
      "Services\\": "src/Services/",
      "Notification\\": "src/Notification/",
      "Modules\\": "app/Modules/"
    },
    "files": [
      "src/Foundation/AppLoaderFunctions.php"
    ]
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "style": "default",
  "tailwind": {},
  "rsc": false,
  "aliases": {},
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  }
}
