#!/usr/bin/env php
<?php

require_once __DIR__ . '/vendor/autoload.php';

// Load framework configuration (handles .env)
require_once __DIR__ . '/bootstrap/config.php';

use Foundation\Console\ControllerGenerator;
use Foundation\Console\CronRunner;
use Foundation\Console\ModuleGenerator;
use Database\Schema\DatabaseInitializer;
use Database\Migrations\MigrationRunner;
use Database\Database;
use Foundation\Console\Doctor;
use Foundation\Console\QueueWorker;
use Foundation\Console\ModelMigrator;

$command = $argv[1] ?? null;

if ($command === 'make:module') {
    $name = $argv[2] ?? null;
    if (!$name) {
        echo "Usage: php oryn make:module <ModuleName>\n";
        exit(1);
    }
    $example = in_array('--example', $argv, true);
    (new ModuleGenerator())->generate($name, $example);
} elseif ($command === 'make:controller') {
    $name = $argv[2] ?? null;
    if (!$name) {
        echo "Usage: php oryn make:controller <ModuleName>\n";
        exit(1);
    }
    (new ControllerGenerator())->generate($name);
} elseif ($command === 'cache:clear') {
    $cacheDir = __DIR__ . '/storage/cache';
    if (!is_dir($cacheDir)) {
        echo "No cache directory found at {$cacheDir}.\n";
        exit(0);
    }
    $files = glob($cacheDir . '/*');
    foreach ($files as $file) {
        if (is_file($file)) {
            unlink($file);
        }
    }
    echo "Cache cleared: {$cacheDir}\n";
} elseif ($command === 'test') {
    $phpunit = __DIR__ . '/vendor/bin/phpunit';
    if (!is_file($phpunit)) {
        $phpunit = 'phpunit';
    }
    $cmd = escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg($phpunit);
    passthru($cmd, $exitCode);
    exit($exitCode);
} elseif ($command === 'doctor') {
    exit((new Doctor())->check(__DIR__));
} elseif ($command === 'db:init') {
    $sqlPath = __DIR__ . '/src/Database/Schema/init.sql';
    $initializer = new DatabaseInitializer(new Database());
    $result = $initializer->initialize($sqlPath);

    echo $result['message'] . "\n";
    if ($result['status'] === 'error') exit(1);
} elseif ($command === 'db:seed') {
    $sqlPath = __DIR__ . '/src/Database/Schema/seed.sql';
    $initializer = new DatabaseInitializer(new Database());
    $result = $initializer->initialize($sqlPath);

    echo $result['message'] . "\n";
    if ($result['status'] === 'error') exit(1);
} elseif ($command === 'db:migrate') {
    // With no second arg: run RBAC-related migrations in order (section → menu).
    // With arg: run that single SQL file relative to project root.
    $arg = $argv[2] ?? null;
    $files = $arg === null
        ? [
            'src/Database/migrations/20260213_create_mx_section_table.sql',
            'src/Database/migrations/20260212_create_mx_menu_table.sql',
            'src/Database/migrations/20260214_seed_sidebar_menus.sql',
            'src/Database/migrations/20260215_cleanup_utility_menu_children.sql',
            'src/Database/migrations/20260216_sidebar_menu_restructure.sql',
            'src/Database/migrations/20260217_mu_arms_sidebar_layout.sql',
            'src/Database/migrations/20260525_complete_menu_permission_module_permissions.sql',
        ]
        : [ltrim($arg, '/\\')];

    $initializer = new DatabaseInitializer(new Database());
    $exitCode = 0;

    foreach ($files as $relative) {
        $sqlPath = __DIR__ . DIRECTORY_SEPARATOR . str_replace(['/', '\\'], DIRECTORY_SEPARATOR, $relative);

        if (!is_file($sqlPath)) {
            echo "SQL file not found: {$sqlPath}\n";
            echo "Usage: php oryn db:migrate [relative/path/to/file.sql]\n";
            exit(1);
        }

        $result = $initializer->initialize($sqlPath);
        echo $result['message'] . "\n";
        if ($result['status'] === 'error') {
            $exitCode = 1;
            break;
        }
    }

    if ($exitCode === 0 && $arg === null) {
        echo "Note: Top-level mx_menu.txt_name must match mx_section.txt_name for sidebar visibility (RBAC).\n";
    }

    if ($exitCode !== 0) {
        exit($exitCode);
    }
} elseif ($command === 'migrate') {
    $runner = new MigrationRunner(new Database());
    $results = $runner->run(__DIR__ . '/src/Database/migrations');
    $exitCode = 0;

    foreach ($results as $result) {
        echo '[' . strtoupper($result['status']) . '] ' . $result['name'] . ' - ' . $result['message'] . "\n";
        if ($result['status'] === 'error') {
            $exitCode = 1;
        }
    }

    exit($exitCode);
} elseif ($command === 'migrate:status') {
    $runner = new MigrationRunner(new Database());
    foreach ($runner->status(__DIR__ . '/src/Database/migrations') as $row) {
        echo '[' . strtoupper($row['status']) . '] ' . $row['name'];
        if ($row['applied_at']) {
            echo ' @ ' . $row['applied_at'];
        }
        echo "\n";
    }
} elseif ($command === 'queue:work') {
    $maxJobs = 0;
    $sleepSeconds = 3;
    $stopWhenEmpty = in_array('--stop-when-empty', $argv, true);

    foreach ($argv as $arg) {
        if (str_starts_with($arg, '--max-jobs=')) {
            $maxJobs = max(0, (int)substr($arg, 11));
        }
        if (str_starts_with($arg, '--sleep=')) {
            $sleepSeconds = max(0, (int)substr($arg, 8));
        }
    }

    if (in_array('--once', $argv, true)) {
        $maxJobs = 1;
        $stopWhenEmpty = true;
    }

    (new QueueWorker())->work($maxJobs, $sleepSeconds, $stopWhenEmpty);
} elseif ($command === 'cron:run') {
    $maxJobs = 25;
    foreach ($argv as $arg) {
        if (str_starts_with($arg, '--max-jobs=')) {
            $maxJobs = max(0, (int)substr($arg, 11));
        }
    }

    exit((new CronRunner())->run(__DIR__, $maxJobs));
} elseif ($command === 'migrate:auto') {
    $dryRun = in_array('--dry-run', $argv, true);
    (new ModelMigrator())->migrate($dryRun);
} else {
    echo "Oryn CLI Utility\n";
    echo "--------------------\n";
    echo "Use `php oryn <command>` or legacy `php zt <command>`.\n";
    echo "Available commands:\n";
    echo "  make:module <Name> [--example] Scaffold a new module\n";
    echo "  make:controller <Name> Scaffold a new module controller\n";
    echo "  cache:clear           Clear runtime cache directory\n";
    echo "  doctor                Run lightweight environment checks\n";
    echo "  test                  Run PHPUnit tests\n";
    echo "  db:init               Initialize database with core schema\n";
    echo "  db:seed               Seed database with initial data\n";
    echo "  db:migrate [file]     Run SQL migration(s); default = section, mx_menu, sidebar seed\n";
    echo "  migrate               Run pending migrations and record them\n";
    echo "  migrate:status        Show applied/pending migrations\n";
    echo "  migrate:auto          Auto-generate tables from Model \$schema arrays\n";
    echo "  queue:work [--once] [--max-jobs=N] [--sleep=N] Start the background job queue worker\n";
    echo "  cron:run [--max-jobs=N] Run cron-safe lifecycle tasks once\n";
}
